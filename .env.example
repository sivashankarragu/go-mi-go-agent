# GoMigo environment variables (example values only — never commit real credentials).
# Set them as process/user environment variables (the API does not load .env files itself);
# "__" maps to ":" in ASP.NET Core configuration keys.
# Alternative for local dev: dotnet user-secrets (UserSecretsId: gomigo-api-dev).

# PostgreSQL connection (used when Persistence__Provider=Postgres)
ConnectionStrings__GoMigo=Host=localhost;Port=5432;Database=gomigo;Username=postgres;Password=CHANGE_ME

# Postgres | InMemory (InMemory needs no database; data is lost on restart)
Persistence__Provider=Postgres

# Mock | TinyFish
Research__Provider=Mock
# Mock scenarios for demos: Success | Partial | Failure | Empty
Research__Mock__Scenario=Success

# TinyFish Web Agent API key (https://agent.tinyfish.ai/api-keys). Backend only.
TINYFISH_API_KEY=

# Used by database/migrate.ps1 (psql)
PGPASSWORD=CHANGE_ME
