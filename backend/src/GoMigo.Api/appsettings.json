{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GoMigo": ""
  },
  "Persistence": {
    "Provider": "Postgres"
  },
  "Research": {
    "Provider": "Mock",
    "RunTimeoutSeconds": 300,
    "MaxCandidates": 10,
    "MaxConcurrentRuns": 2,
    "Mock": {
      "Scenario": "Success",
      "StepDelayMilliseconds": 600
    }
  },
  "TinyFish": {
    "BaseUrl": "https://agent.tinyfish.ai",
    "HttpTimeoutSeconds": 30,
    "InitialPollIntervalSeconds": 3,
    "MaxPollIntervalSeconds": 6,
    "MaxStepsPerSource": null,
    "MaxDurationSecondsPerSource": 180,
    "MaxVenuesPerSource": 8,
    "MaxSourcesPerRun": 1,
    "Sources": [
      {
        "Name": "Wikivoyage: Bengaluru East",
        "Url": "https://en.wikivoyage.org/wiki/Bengaluru/East",
        "Areas": [ "Indiranagar", "Indira Nagar", "HAL", "Domlur", "Whitefield", "Marathahalli", "Bellandur", "Old Airport Road", "Cox Town", "Frazer Town", "Fraser Town", "Richards Town", "Kundalahalli", "Brookefield" ]
      },
      {
        "Name": "Wikivoyage: Bengaluru East Central",
        "Url": "https://en.wikivoyage.org/wiki/Bengaluru/East_Central",
        "Areas": [ "MG Road", "M.G. Road", "Mahatma Gandhi Road", "Brigade Road", "Church Street", "Ulsoor", "Halasuru", "Residency Road", "Richmond", "Commercial Street", "St Marks Road", "Lavelle Road" ]
      },
      {
        "Name": "Wikivoyage: Bengaluru West Central",
        "Url": "https://en.wikivoyage.org/wiki/Bengaluru/West_Central",
        "Areas": [ "Cubbon", "Majestic", "Chickpet", "KR Market", "K.R. Market", "Vidhana Soudha", "UB City", "Gandhi Nagar", "Cottonpet", "Shivajinagar", "Kasturba Road" ]
      },
      {
        "Name": "Wikivoyage: Bengaluru South",
        "Url": "https://en.wikivoyage.org/wiki/Bengaluru/South",
        "Areas": [ "Koramangala", "Jayanagar", "JP Nagar", "J.P. Nagar", "BTM", "Basavanagudi", "HSR", "Electronic City", "Bannerghatta", "Madiwala", "Sarjapur", "Banashankari", "Lalbagh" ]
      },
      {
        "Name": "Wikivoyage: Bengaluru North",
        "Url": "https://en.wikivoyage.org/wiki/Bengaluru/North",
        "Areas": [ "Hebbal", "Yelahanka", "Malleswaram", "Malleshwaram", "Yeshwanthpur", "Yeshwantpur", "Rajajinagar", "Sadashivanagar", "Banaswadi", "Sahakar Nagar", "Seshadripuram", "Mathikere" ]
